{
  "name": "theeye",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build:dashboard": "pnpm --filter dashboard build",
    "lint:dashboard": "pnpm --filter dashboard lint",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/dashboard/**/*.{ts,tsx}": "pnpm --filter dashboard exec eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
