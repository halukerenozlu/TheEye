# Copy to .env in this directory. Every value below is optional: docker-compose.yml
# falls back to the same defaults, so `docker compose up` works without a .env file.
#
#   cp infra/.env.example infra/.env

# Compose project name (prefixes container and volume names).
COMPOSE_PROJECT_NAME=theeye

# --- Postgres / PostGIS ---
POSTGRES_USER=theeye
POSTGRES_PASSWORD=theeye
POSTGRES_DB=theeye

# --- Host ports ---
# Change these when something else already listens on the default port.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

# --- Collector ---
# How often the ingest loop runs. Any Go duration: 30s, 5m, 1h.
COLLECTOR_INTERVAL=5m

# Feed URLs. Leave empty to use the defaults compiled into the collector
# (usgs.DefaultFeedURL / eonet.DefaultFeedURL).
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
EONET_FEED_URL=
